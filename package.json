{
  "name": "artem-trikula-cv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:seo": "node tests/seo.production.mjs",
    "validate:deployment": "node scripts/validate-deployment.mjs",
    "test:visual": "node tests/build-production.mjs && playwright test",
    "test:visual:update": "node tests/build-production.mjs && playwright test --update-snapshots",
    "test:visual:report": "playwright show-report artifacts/playwright/report"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "lighthouse": "^13.4.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
